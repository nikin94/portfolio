{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2025-06-01",
  // A Worker fronts the prerendered `dist/` assets. `run_worker_first` routes
  // only `/api/*` through the Worker script; every other request is served
  // straight from static assets (with the SPA 404 fallback). `npx wrangler
  // deploy` (the dashboard's deploy command) reads this.
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Unknown URLs serve the app shell (index.html); the router's catch-all
    // route then redirects them home — a soft "404 → home".
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  // Cloudflare Email Routing binding — the contact form's `POST /api/contact`
  // sends through this. `destination_address` must be a verified address in the
  // zone's Email Routing settings.
  "send_email": [
    { "name": "SEND_EMAIL", "destination_address": "nikin1994@gmail.com" },
  ],
  // Per-IP rate limit for the contact endpoint — configured entirely here, so
  // no dashboard/KV setup is needed. `period` is limited to 10 or 60s by the
  // platform; 5 requests / 60s is plenty for a real sender and throttles a
  // script hammering the inbox. `namespace_id` is any account-unique integer.
  "unsafe": {
    "bindings": [
      {
        "name": "CONTACT_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "2001",
        "simple": { "limit": 5, "period": 60 },
      },
    ],
  },
}
